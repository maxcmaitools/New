# ══════════════════════════════════════════════════════════════════════════════
# Morning Briefing — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# Claude API key (required) — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── SMTP Email Settings ────────────────────────────────────────────────────
# The email will be sent FROM this address TO max.corfield@stages.co.uk

# --- Gmail / Google Workspace (recommended) ---
# Use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BRIEFING_FROM_EMAIL=you@gmail.com

# --- Microsoft 365 / Outlook ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_TLS=false
# SMTP_USER=you@stages.co.uk
# SMTP_PASSWORD=YourPassword
# BRIEFING_FROM_EMAIL=briefing@stages.co.uk

# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_TLS=true
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# BRIEFING_FROM_EMAIL=briefing@stages.co.uk

